# TMDB v4 read token (Authorization header). The crawler worker
# workers/prerender-worker uses this same value as secret TMDB_API_KEY.
VITE_API_KEY=Bearer TMDB_API_KEY

# TMDB daily exports are public — no key required for npm run generate:sitemap
# SITEMAP_MAX_MOVIES=32000
# SITEMAP_MAX_TV=10000
# SITEMAP_MAX_PEOPLE=7500
# SITEMAP_MIN_POPULARITY=1
# SITEMAP_USE_EXPORT=1
# SITEMAP_EXPORT_DATE=08_27_2026

# Backend API URL
VITE_API_URL=http://localhost:3000

# PayPal SDK v6 Configuration
# Set to 'sandbox' for testing or 'live' for production
VITE_PAYPAL_MODE=sandbox